# Required — from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here
GUILD_ID=your_server_id_here
LOG_CHANNEL_ID=your_log_channel_id_here

# Optional — only members with this role can run /purchase
# If empty, anyone with Manage Roles can use the commands
ADMIN_ROLE_ID=

# Optional — where assignment records are saved
# On Render, attach a disk and set this to /data
DATA_DIR=./data

# Optional — how long the purchased role lasts
ROLE_DURATION_MONTHS=6

# Render sets PORT automatically. Do not hardcode it in production.
# PORT=10000
